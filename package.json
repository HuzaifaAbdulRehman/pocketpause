{
  "name": "pocketpause",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "test": "node --test tests/domain.test.ts tests/ollama.test.ts tests/server.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser.mjs test",
    "setup:browser": "node scripts/browser.mjs install chromium",
    "build": "vite build",
    "start": "node src/server.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.1",
    "@playwright/test": "1.63.0"
  }
}
